# NVIDIA Rate-Limited Proxy — environment configuration
# Copy this file to .env and fill in your real values:
#   copy .env.example .env
# The proxy auto-loads .env on startup.

# Your NVIDIA API key (used by the proxy for upstream calls)
NVIDIA_API_KEY=your-real-nvidia-api-key-here

# Upstream NVIDIA API base URL
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model used when a client sends an unknown model name (TC-027)
# NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# Comma-separated list of valid NVIDIA models (passed through untouched).
# Override if you use models not in the default list.
# NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,meta/llama-3.3-70b-instruct,z-ai/glm-5.2

# true = rewrite unknown client models to NVIDIA_DEFAULT_MODEL (defensive, TC-027)
# false = pass unknown models through as-is (use when your client sends real NVIDIA models)
# REWRITE_UNKNOWN_MODELS=true

# --- Rate limiter -----------------------------------------------------------
# Max requests per minute (window size)
# MAX_RPM=40
# Window length in seconds
# WINDOW_SIZE=60
# Max queue depth before rejecting with 503 + Retry-After (TC-029)
# MAX_QUEUE=500
# Seconds before a queued low-priority request is promoted to priority 1 (TC-017)
# RETRY_TTL=300

# --- Upstream HTTP behavior --------------------------------------------------
# Retries on upstream 429. -1 = retry forever so 429s never reach clients.
# Set a positive number to cap retries (TC-018).
# HTTP_RETRIES=-1
# Backoff base seconds; waits at least until the sliding window has room,
# and honours any Retry-After header from NVIDIA.
# BACKOFF_BASE=1.0
# httpx timeouts (seconds)
# CONNECT_TIMEOUT=30
# READ_TIMEOUT=60
# WRITE_TIMEOUT=30
# POOL_TIMEOUT=30
# Max age of an in-flight stream before the sweeper force-releases it (TC-020)
# MAX_STREAM_AGE=300
# Sweeper interval in seconds
# SWEEP_INTERVAL=5

# --- Priority / payload -------------------------------------------------------
# Payload size (bytes) above which a request defaults to priority 5 when no
# X-Priority header is present (TC-025)
# LARGE_BODY_BYTES=262144

# --- Server -------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000